# ============================================================
# Пример конфигурации для telegram_ping_bot
# Скопируйте этот файл в .env и заполните РЕАЛЬНЫМИ значениями:
#     cp .env.example .env
# Файл .env НЕ должен попадать в git (см. .gitignore).
# ============================================================

# Токен Telegram-бота получить у @BotFather (/revoke — если старый токен засвечен)
TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Прокси для сессии бота (SOCKS5/HTTP). Пустая строка = прямое соединение.
# Пример: socks5://user:pass@host:1080
PROXY_URL=

# Лимит одновременных пингов (можно менять на лету через /admin)
MAX_CONCURRENT_PINGS=3

# ID администратора бота (числовой user_id)
ADMIN_ID=123456789

# --- Аварийные алерты о недоступности IP ---
# ID чата/группы куда слать алерты (для супергруппы — отрицательный -100...).
# Оставьте пустым, чтобы отключить алерты в чат.
ALERT_CHAT_ID=
# ID темы/топика внутри чата (если тем нет — оставьте пустым)
ALERT_THREAD_ID=

# --- Пути (Этап 7, инфраструктура) ---
# Необязательные. По умолчанию: DATA_DIR=data, ENV_FILE=<код рядом с .env>.
# В Docker задаются через docker-compose.yml (DATA_DIR=/app/data,
# ENV_FILE=/app/data/.env) — менять не нужно.
# DATA_DIR=./data
# ENV_FILE=./data/.env

# ВАЖНО про прокси: PROXY_URL влияет ТОЛЬКО на соединения бота с Telegram API.
# Пинги (ICMP) при /scan и мониторинге всегда выполняются напрямую с сервера
# (subprocess ping) и через прокси НЕ идут.
